[
        {
                "label": "BUILD & RUN",

                "command": "bash",

                "args": [
                        "-c",
                        "cd \"$ZED_WORKTREE_ROOT\" && gcc -o PROGRAM $(find . -name \"*.c\") && ./PROGRAM",
                ],
        },

        {
                "label": "OPEN LAZYGIT",

                "command": "kitty",
                "args": ["--directory", "$ZED_WORKTREE_ROOT", "lazygit & disown"],
                "use_new_terminal": false,
                "allow_concurrent_runs": false
        },
]
