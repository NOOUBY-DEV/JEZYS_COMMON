[
        {
                "label": "BUILD & RUN",

                "command": "bash",

                "args": [
                        "-c",
                        "cd \"$ZED_WORKTREE_ROOT\" && gcc -o TEST $(find . -name \"*.c\") && ./TEST",
                ]
        },

        {
                "label": "OPEN LAZYGIT",

                "command": "kitty",
                "args": ["--directory", "$ZED_WORKTREE_ROOT", "lazygit & disown"]
        },
]
